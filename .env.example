# Copy to .env for local development (see dev-local.mjs). Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/superior_patio
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: override the lead sheet CSV URL (defaults to the dev copy in leadSync.ts)
# LEAD_SHEET_CSV_URL=

# --- Connections (Settings > Connections) -----------------------------------
# QuickBooks Online: an app from developer.intuit.com. Sandbox first.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox            # or production
# QBO_REDIRECT_URI=https://<your-domain>/api/integrations/quickbooks/callback

# Google Sheets write-back: a service account key, base64-encoded to one line
# (base64 -w0 key.json). The admin shares the sheet with the account's email.
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Optional default sheet; the admin can change it in Settings.
# SPC_SHEET_ID=
